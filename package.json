{
  "name": "agentic-formats",
  "version": "0.3.0",
  "description": "Read and write open office files: ODF and OOXML for documents, spreadsheets, and slides.",
  "keywords": [
    "odf",
    "ooxml",
    "odt",
    "ods",
    "odp",
    "docx",
    "xlsx",
    "pptx",
    "office",
    "documents",
    "import",
    "export",
    "agents",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-formats.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-formats",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-formats": "./dist/cli.js",
    "agentic-formats-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fflate": "^0.8.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
